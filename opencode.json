{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "ledger": {
      "type": "local",
      "command": ["python", "-m", "kiraci.mcp_server"],
      "enabled": true
    },
    "queue": {
      "type": "local",
      "command": ["python", "-m", "kiraci.queue_mcp"],
      "enabled": true
    }
