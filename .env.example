# Each tier accepts a comma-separated fallback chain (primary first).
# The runner tries the next model on quota/rate-limit and retries the
# primary daily.
KIRACI_MODEL_STRONG=provider/model,provider/model-fallback
KIRACI_MODEL_MID=provider/model,provider/model-fallback
KIRACI_MODEL_CHEAP=provider/model,provider/model-fallback
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
LEMONSQUEEZY_API_KEY=
KIRACI_OWNER_NAME=
OPENROUTER_API_KEY=
KIRACI_BACKUP_DIR=
# Database and config paths (defaults shown).
KIRACI_DB=data/kiraci.db
KIRACI_CONFIG=config.toml
# Daemon snapshot log (SQLite, TASK2 Phase 1.2).
KIRACI_STATE_DB=data/state.db
# Sandbox: mode=required blocks agent runs when bubblewrap is unusable.
# KIRACI_SANDBOX=off with KIRACI_ALLOW_UNSANDBOXED=1 runs read-only agents only.
# KIRACI_SANDBOX=
# KIRACI_ALLOW_UNSANDBOXED=
