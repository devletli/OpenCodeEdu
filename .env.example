# Each tier accepts a comma-separated fallback chain (primary first).
# The runner tries the next model on quota/rate-limit and retries the
# primary daily.
KIRACI_MODEL_STRONG=provider/model,provider/model-fallback
KIRACI_MODEL_MID=provider/model,provider/model-fallback
KIRACI_MODEL_CHEAP=provider/model,provider/model-fallback
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
LEMONSQUEEZY_API_KEY=
KIRACI_OWNER_NAME=
OPENROUTER_API_KEY=
KIRACI_BACKUP_DIR=
